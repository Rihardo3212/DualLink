<Project Sdk="Microsoft.NET.Sdk">
  <!--
    DualLink's native window (WinUI 3). It shows the same things as the web window and talks to the engine
    (DualLink.exe) over the local control API. Built by GitHub Actions and installed next to DualLink.exe in a
    "DualLinkWindow" folder.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DualLinkWindow</RootNamespace>
    <AssemblyName>DualLinkWindow</AssemblyName>
    <Version>1.12.0</Version>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\duallink\assets\icon_on.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- compiled ahead of time when published: starts fast, no .NET runtime to load -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\duallink\assets\icon_on.ico" Link="icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\icon.png" Link="logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
